# PayPal sandbox app credentials (Developer Dashboard > Apps & Credentials > Sandbox)
# Client ID is public; Client Secret is PRIVATE — server-side only, never commit the real file.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=SANDBOX

# LLM provider key for the agent brain (Vercel AI SDK, provider-agnostic)
AI_API_KEY=
AI_MODEL=

# Sandbox test accounts (Testing Tools > Sandbox Accounts > View/Edit Account)
PAYPAL_SANDBOX_BUSINESS_EMAIL=
PAYPAL_SANDBOX_PERSONAL_EMAIL=

# Webhook intake (Phase 1D): id returned by scripts/register-webhook.mjs.
# While empty, /api/webhooks/paypal runs in clearly-labelled unverified-dev
# mode (accepts events without signature checks — development only).
PAYPAL_WEBHOOK_ID=

# Job endpoints (Phase 1D): shared secret required in the x-job-secret
# header for POST /api/jobs/*. While empty, the job endpoints refuse to run.
GUARDIAN_JOB_SECRET=
